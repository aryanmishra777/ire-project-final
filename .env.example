# Hosted rewriting LLM (default provider). Free key: https://console.groq.com
GROQ_API_KEY=
LLM_PROVIDER=ollama
GROQ_MODEL=llama-3.1-8b-instant
# Local rewriting through Ollama (default provider in this project)
OLLAMA_MODEL=qwen3.6-moe
# Dense retriever (default: one of LitSearch's published baselines)
DENSE_MODEL=intfloat/e5-large-v2
OLLAMA_NUM_CTX=24576
